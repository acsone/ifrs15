<odoo>
    <record id="perf_obligation_tree" model="ir.ui.view">
        <field name="name">perf.obligation.list</field>
        <field name="model">perf.obligation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="perf_type" />
                <field name="currency_id" column_invisible="1" />
                <field name="total_amount" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="description" optional="hide" />
            </list>
        </field>
    </record>

    <record id="perf_obligation_form" model="ir.ui.view">
        <field name="name">perf.obligation.form</field>
        <field name="model">perf.obligation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_generate_schedule"
                        string="(Re)generate Schedule Entries"
                        type="object"
                        class="btn-primary"
                        invisible="not supports_schedule"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_move_lines"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-list"
                        >
                            <field
                                name="move_line_count"
                                widget="statinfo"
                                string="Journal Items"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <span class="o_form_label">Performance Obligation</span>
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <field
                        name="description"
                        nolabel="1"
                        placeholder="Add a description..."
                    />
                    <group>
                        <group name="recognition_info" string="Recognition">
                            <field name="currency_id" invisible="1" />
                            <field name="perf_type" string="Type" />
                            <field
                                name="total_amount"
                                string="Total Amount to Recognize"
                            />
                            <field name="invoiced_amount" />
                            <field
                                name="recognition_at_date_method"
                                string="Recognition Method"
                            />
                            <field
                                name="pl_account_id"
                                domain="([('internal_group', '=', perf_type)] if perf_type else []) + [('deprecated', '=', False)]"
                            />
                        </group>

                        <group name="administration_info" string="Administration">
                            <field
                                name="create_date"
                                string="Created on"
                                readonly="1"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Recognition Schedule" name="schedule">
                            <field
                                name="schedule_income_line_ids"
                                invisible="perf_type != 'income'"
                                nolabel="1"
                            >
                                <list create="false" edit="false" delete="false">
                                    <field name="date" />
                                    <field name="move_id" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'posted'"
                                    />
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="invoiced_amount" />
                                    <field name="deferred_accrued_amount" />
                                    <field name="recognized_amount" optional="hide" />
                                    <field name="total_invoiced_amount" />
                                    <field
                                        name="total_deferred_accrued_amount"
                                        optional="hide"
                                    />
                                    <field name="total_recognized_amount" />
                                </list>
                            </field>
                            <field
                                name="schedule_expense_line_ids"
                                invisible="perf_type != 'expense'"
                                nolabel="1"
                            >
                                <list create="false" edit="false" delete="false">
                                    <field name="date" />
                                    <field name="move_id" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'posted'"
                                    />
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="billed_amount" />
                                    <field name="deferred_accrued_amount" />
                                    <field name="recognized_amount" optional="hide" />
                                    <field name="total_billed_amount" />
                                    <field
                                        name="total_deferred_accrued_amount"
                                        optional="hide"
                                    />
                                    <field name="total_recognized_amount" />
                                </list>
                            </field>
                        </page>
                        <page
                            string="Recognition Schedule by Month"
                            name="schedule_monthly"
                        >
                            <field
                                name="schedule_income_monthly_line_ids"
                                invisible="perf_type != 'income'"
                                nolabel="1"
                            >
                                <list create="false" edit="false" delete="false">
                                    <field name="month" string="Month" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'posted'"
                                        decoration-warning="state == 'mixed'"
                                    />
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="invoiced_amount" />
                                    <field name="deferred_accrued_amount" />
                                    <field name="recognized_amount" optional="hide" />
                                    <field name="total_invoiced_amount" />
                                    <field
                                        name="total_deferred_accrued_amount"
                                        optional="hide"
                                    />
                                    <field name="total_recognized_amount" />
                                </list>
                            </field>
                            <field
                                name="schedule_expense_monthly_line_ids"
                                invisible="perf_type != 'expense'"
                                nolabel="1"
                            >
                                <list create="false" edit="false" delete="false">
                                    <field name="month" string="Month" />
                                    <field
                                        name="state"
                                        widget="badge"
                                        decoration-info="state == 'draft'"
                                        decoration-success="state == 'posted'"
                                        decoration-warning="state == 'mixed'"
                                    />
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="billed_amount" />
                                    <field name="deferred_accrued_amount" />
                                    <field name="recognized_amount" optional="hide" />
                                    <field name="total_billed_amount" />
                                    <field
                                        name="total_deferred_accrued_amount"
                                        optional="hide"
                                    />
                                    <field name="total_recognized_amount" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="perf_obligation_search" model="ir.ui.view">
        <field name="name">perf.obligation.search</field>
        <field name="model">perf.obligation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <filter
                    name="income"
                    string="Income"
                    domain="[('perf_type', '=', 'income')]"
                />
                <filter
                    name="expense"
                    string="Expense"
                    domain="[('perf_type', '=', 'expense')]"
                />
                <separator />
                <filter
                    name="needs_regeneration"
                    string="Needs Regeneration"
                    domain="[('schedule_needs_regeneration', '=', True)]"
                />
                <separator />
                <filter
                    name="over_invoiced"
                    string="Over Invoiced"
                    domain="[('is_over_invoiced', '=', True)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_type"
                        string="Type"
                        context="{'group_by': 'perf_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_process_pending_regenerations_server" model="ir.actions.server">
        <field name="name">Process Pending Regenerations</field>
        <field name="model_id" ref="model_perf_obligation" />
        <field name="binding_model_id" ref="model_perf_obligation" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            records.action_process_pending_regenerations()
        </field>
    </record>

    <record id="action_perf_obligation" model="ir.actions.act_window">
        <field name="name">Performance Obligations</field>
        <field name="res_model">perf.obligation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Performance Obligation
            </p>
        </field>
    </record>
</odoo>

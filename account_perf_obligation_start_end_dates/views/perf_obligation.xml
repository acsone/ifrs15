<odoo>
    <record id="perf_obligation_form_inherit_dates" model="ir.ui.view">
        <field name="name">perf.obligation.form.inherit.dates</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_form" />
        <field name="arch" type="xml">
            <field name="recognition_at_date_method" position="after">
                <field name="is_start_date_required" invisible="1" />
                <field name="is_end_date_required" invisible="1" />
                <field
                    name="start_date"
                    string="Recognition Period"
                    widget="daterange"
                    options="{'end_date_field': 'end_date'}"
                    invisible="not is_start_date_required and not is_end_date_required"
                    required="is_start_date_required"
                />
                <field name="end_date" invisible="1" required="is_end_date_required" />
            </field>
        </field>
    </record>

    <record id="perf_obligation_tree_inherit_dates" model="ir.ui.view">
        <field name="name">perf.obligation.list.inherit.dates</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_tree" />
        <field name="arch" type="xml">
            <field name="total_amount" position="after">
                <field name="recognition_at_date_method" optional="hide" />
                <field name="start_date" optional="show" />
                <field name="end_date" optional="show" />
            </field>
        </field>
    </record>

    <record id="perf_obligation_search_inherit_dates" model="ir.ui.view">
        <field name="name">perf.obligation.search.inherit.dates</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_search" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='needs_regeneration']" position="before">
                <separator />
                <filter
                    name="end_date_passed"
                    string="End Date passed"
                    domain="[('end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                />
                <separator />
            </xpath>
        </field>
    </record>
</odoo>
